{
  "name": "brain-teasers",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:updates": "node scripts/update-flow.cjs",
    "screenshots": "scripts/build-screens.sh && python3 .claude/skills/webapp-testing/scripts/with_server.py --server 'exec python3 -m http.server 4173 --directory .screens/builds >/dev/null 2>&1' --port 4173 -- node scripts/screenshots.cjs",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource-variable/literata": "5.3.0",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vitejs/plugin-react": "6.1.2",
    "katex": "0.18.10",
    "marked": "18.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "yaml": "2.9.1"
  }
}
